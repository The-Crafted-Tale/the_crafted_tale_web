# editorconfig.org
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# TypeScript / JavaScript / Vue
[*.{ts,tsx,js,mjs,cjs,vue}]
quote_type = double

# Shell scripts
[*.sh]
end_of_line = lf
